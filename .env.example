# OpenAI is required for weak-node extraction, agent execution, and LLM judging.
OPENAI_API_KEY=
OPENAI_EXTRACTION_MODEL=gpt-4o-mini-2024-07-18
OPENAI_AGENT_MODEL=gpt-4o-mini-2024-07-18
OPENAI_BASELINE_MODEL=gpt-4o-mini-2024-07-18
OPENAI_JUDGE_MODEL=gpt-5-2025-08-07
OPENAI_DATASET_MODEL=gpt-5-2025-08-07
OPENAI_CONVERSATION_MODEL=gpt-5-2025-08-07

# Neo4j connection used by ingestion, the API, and graph-based evaluations.
NEO4J_URI=bolt://localhost:7687
NEO4J_USER=neo4j
NEO4J_PASSWORD=
NEO4J_DATABASE=shabdb

# Local paths. Relative paths are resolved from the repository root.
# Set these only after reviewing and accepting the current terms on the
# Official Gazettes Portal. Renew the confirmation at least every 90 days.
SHAB_TERMS_ACCEPTED=false
SHAB_TERMS_ACCEPTED_DATE=
SHAB_START_DATE=2018-09-02
SHAB_END_DATE=2025-12-31
SHAB_OUTPUT_DIR=shab_data
SHAB_DELAY_SEC=1
SHAB_MAX_RETRIES=3
INPUT_GLOB=shab_data/*
OUTPUT_DIR=processed_data/processed_graph_data_archive
PROCESSED_GRAPH_DIR=processed_data/processed_graph_data_archive
EVAL_OUTPUT_DIR=evaluation/results
AUTOMATED_DATASET_PATH=evaluation/datasets/automated_dataset.json
CHROMA_DB_PATH=evaluation/baseline_rag/chroma_db
MAX_WORKERS=4
ROW_LIMIT=

# Dashboard and optional ingestion controls.
CORS_ORIGINS=http://localhost:3000
ANONYMIZE_DATA=false
ANONYMIZATION_SECRET_KEY=
ANONYMIZATION_OUTPUT=processed_data/anonymization_mapping.json
SKIP_ANALYTICS=false
